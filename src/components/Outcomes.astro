<section class="section" id="outcomes">
  <div class="container">
    <div class="section-label">WHAT TO EXPECT</div>
    <h2 class="section-title heading-font">
      Indicative outcomes across claims,<br>
      <span class="accent">package profitability, and payer intelligence</span>
    </h2>
    <p class="outcomes-caveat">
      Indicative ranges based on the Design phase. Actual improvement is anchored in your Audit baseline.
    </p>

    <div class="outcomes-grid">
      <div class="outcome-stat-card">
        <span class="stat-value">40–60%</span>
        <span class="stat-label">Claim submission TAT reduction</span>
      </div>
      <div class="outcome-stat-card">
        <span class="stat-value">10–15 pp</span>
        <span class="stat-label">First-pass acceptance rate improvement</span>
      </div>
      <div class="outcome-stat-card">
        <span class="stat-value">30–50%</span>
        <span class="stat-label">Query rate reduction</span>
      </div>
      <div class="outcome-stat-card">
        <span class="stat-value">40–60%</span>
        <span class="stat-label">Query closure TAT reduction</span>
      </div>
      <div class="outcome-stat-card">
        <span class="stat-value">20–40%</span>
        <span class="stat-label">Deduction rate reduction</span>
      </div>
      <div class="outcome-stat-card">
        <span class="stat-value">15–30%</span>
        <span class="stat-label">Revenue recovered through appeals</span>
      </div>
      <div class="outcome-stat-card">
        <span class="stat-value">8–15%</span>
        <span class="stat-label">Improvement in package-level margin</span>
      </div>
      <div class="outcome-stat-card">
        <span class="stat-value">30–50%</span>
        <span class="stat-label">Reduction in loss-making package episodes</span>
      </div>
      <div class="outcome-stat-card">
        <span class="stat-value">30–50%</span>
        <span class="stat-label">Staff time per claim reduction</span>
      </div>
    </div>
  </div>
</section>
