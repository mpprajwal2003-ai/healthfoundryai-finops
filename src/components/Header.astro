---
---
<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <!-- Logo -->
      <a href="#" class="brand-logo heading-font">
        <div class="logo-grid-icon">
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
        </div>
        HealthFoundry
      </a>

      <!-- Desktop Navigation Links -->
      <nav>
        <ul class="nav-links">
          <li class="nav-item"><a href="#">Platform</a></li>
          <li class="nav-item active">
            <a href="#">Solutions ▾</a>
            <div class="nav-dropdown">
              <a href="#hero">FinOps & Revenue Cycle</a>
              <a href="#agents">Agent Intelligence</a>
              <a href="#outcomes">Outcomes & Benchmarks</a>
            </div>
          </li>
          <li class="nav-item"><a href="#">Company</a></li>
          <li class="nav-item"><a href="#">Security</a></li>
          <li class="nav-item"><a href="#">Resources</a></li>
          <li class="nav-item"><a href="#">Careers</a></li>
        </ul>
      </nav>

      <!-- Right Header Actions (Theme Switcher + Primary Take a Survey CTA) -->
      <div class="header-actions">
        <!-- Theme Switcher Dropdown -->
        <div class="theme-selector">
          <button class="theme-toggle-btn" id="themeToggleBtn" aria-label="Toggle Theme Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </button>
          <div class="theme-menu" id="themeMenu">
            <button class="theme-option" data-theme-val="light">
              <span>☀️</span> Light Theme
            </button>
            <button class="theme-option" data-theme-val="dark">
              <span>🌙</span> Dark Theme
            </button>
            <button class="theme-option" data-theme-val="bw">
              <span>🔳</span> Black & White
            </button>
            <button class="theme-option" data-theme-val="system">
              <span>💻</span> Default Device Theme
            </button>
          </div>
        </div>

        <!-- Main CTA: Take a Survey (Replaces Book a Call) -->
        <button class="btn btn-primary open-survey-btn">
          Take a Survey
        </button>
      </div>
    </div>
  </div>
</header>
