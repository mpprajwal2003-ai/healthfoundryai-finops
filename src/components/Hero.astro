---
import { frontmatter } from '../data/solutions-finops.md';
const { hero = {} } = frontmatter || {};
---
<section class="hero-section" id="hero">
  <div class="container">
    <div class="hero-grid">
      <!-- Hero Text Content -->
      <div class="hero-content">
        <div class="badge-pill">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
            <polyline points="17 6 23 6 23 12"></polyline>
          </svg>
          {hero.pill || "FinOps"}
        </div>
        
        <h1 class="hero-title heading-font">
          {hero.titleLine1 || "Revenue Cycle Operations,"}<br>
          <span class="accent">{hero.titleAccent || "Rethought"}</span>
        </h1>

        <p class="hero-subtitle">
          {hero.subtitle || "Reduce revenue leakage across the full revenue cycle — not just claims"}
        </p>

        <p class="hero-body">
          {hero.body}
        </p>


        <div class="hero-actions">
          <button class="btn btn-primary open-survey-btn">
            Take a Survey
          </button>
          <a href="#domains" class="btn btn-secondary">
            See the Platform ↓
          </a>
        </div>
      </div>

      <!-- Hero Interactive Dashboard UI Card Mockup -->
      <div class="hero-dashboard-mock">
        <div class="mock-window-header">
          <div class="mock-controls">
            <span class="mock-dot red"></span>
            <span class="mock-dot yellow"></span>
            <span class="mock-dot green"></span>
          </div>
          <div class="mock-title-bar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
            HealthFoundry FinOps Operations Hub — Q1 2026
          </div>
          <div class="mock-status-pill">● System Live</div>
        </div>

        <div class="mock-body">
          <!-- Metric Cards Bar -->
          <div class="mock-metrics-grid">
            <div class="metric-card">
              <span class="metric-label">Total Claims</span>
              <span class="metric-val">30</span>
              <span class="metric-sub">Processing</span>
            </div>
            <div class="metric-card">
              <span class="metric-label">Total Revenue</span>
              <span class="metric-val">₹ 29 L</span>
              <span class="metric-sub">Net Tracked</span>
            </div>
            <div class="metric-card">
              <span class="metric-label">Denied Claims</span>
              <span class="metric-val">1</span>
              <span class="metric-sub alert">3.3% Denial Rate</span>
            </div>
            <div class="metric-card">
              <span class="metric-label">Avg Claim TAT</span>
              <span class="metric-val">11.8 d</span>
              <span class="metric-sub">Discharge → Pay</span>
            </div>
          </div>

          <!-- Live KPI Bars -->
          <div class="mock-insights-box">
            <div class="insights-header">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
              Active Agent FinOps Insights
            </div>
            <div class="insight-item">
              <strong>Star Health TPA</strong>: High denial rate at 18.7% detected on Package CPT 49505. Query auto-drafted.
            </div>
            <div class="insight-item">
              <strong>Package Profitability</strong>: 8 Cardiac Stent packages currently operating at 12% negative margin.
            </div>
            <div class="insight-item">
              <strong>Payer Guideline Alert</strong>: Ayushman Bharat update absorbed; 0 deductions incurred.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
